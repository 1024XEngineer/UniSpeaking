SERVER_PORT=8080
VITE_BACKEND_URL=/backend
VITE_OCR_ENABLED=false
VITE_REALTIME_ICE_TRANSPORT_POLICY=all
VITE_REALTIME_TURN_ENABLED=false
WEB_ALLOWED_ORIGIN_PATTERNS=http://localhost:*

POSTGRES_DB=unispeaking_verify
POSTGRES_USER=unispeaking_verify
POSTGRES_PASSWORD=unispeaking_verify_local_only
DATABASE_URL=jdbc:postgresql://postgres:5432/unispeaking_verify
DATABASE_USERNAME=unispeaking_verify
DATABASE_PASSWORD=unispeaking_verify_local_only
JWT_SECRET=local-verification-only-change-me-32-bytes
JWT_ISSUER=unispeaking-verify
JWT_ACCESS_TOKEN_TTL=2h

AUTH_PERSISTENCE=postgres
AUTH_COOKIE_SECURE=false
AUTH_EMAIL_ENABLED=false
AUTH_CAPTCHA_PROVIDER=development
AUTH_CAPTCHA_DEVELOPMENT_TOKEN=local-human-verified
MANAGEMENT_HEALTH_MAIL_ENABLED=false
UNISPEAKING_ADMIN_PERSISTENCE=postgres
UNISPEAKING_ADMIN_SECURE_COOKIE=false
UNISPEAKING_ADMIN_SESSION_IDLE_SECONDS=1800
UNISPEAKING_ADMIN_SESSION_ABSOLUTE_SECONDS=28800

OCR_ENABLED=false
AI_PROVIDER_ROUTE_REALTIME=
AI_PROVIDER_ROUTE_LLM=
AI_PROVIDER_ROUTE_TRANSCRIPTION=
AI_PROVIDER_ROUTE_TTS=
AI_PROVIDER_ROUTE_SCORING=
REALTIME_FLOW_LOG_FILE=/tmp/realtime-flow.log
