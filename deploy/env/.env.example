# Copy this file to deploy/env/.env and set the real secret there.
# Never commit deploy/env/.env.

SERVER_PORT=8080

DASHSCOPE_API_KEY=replace-with-your-api-key
BAILIAN_WORKSPACE_ID=replace-with-your-workspace-id
BAILIAN_MODEL=qwen3.5-omni-flash-realtime
# BAILIAN_REGION=cn-beijing
# REALTIME_QWEN_TEMPORARY_KEY_TTL_SECONDS=300

# Public frontend setting; never put a secret in a VITE_ variable.
VITE_BACKEND_URL=/backend
